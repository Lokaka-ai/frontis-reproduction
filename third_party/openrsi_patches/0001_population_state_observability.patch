+def _python_random_state_to_json(value: Any) -> Any:
+    if isinstance(value, tuple):
+        return [_python_random_state_to_json(item) for item in value]
+    return value
+
+
+def _python_random_state_from_json(value: Any) -> Any:
+    if isinstance(value, list):
+        return tuple(_python_random_state_from_json(item) for item in value)
+    return value
+
+
+def capture_rng_state() -> dict[str, Any]:
+    numpy_state = numpy.random.get_state()
+    return {
+        "python_random": _python_random_state_to_json(random.getstate()),
+        "numpy_random": {
+            "bit_generator": str(numpy_state[0]),
+            "keys": numpy_state[1].tolist(),
+            "position": int(numpy_state[2]),
+            "has_gauss": int(numpy_state[3]),
+            "cached_gaussian": float(numpy_state[4]),
+        },
+    }
+
+
+def restore_rng_state(payload: dict[str, Any]) -> None:
+    python_state = payload.get("python_random")
+    numpy_payload = payload.get("numpy_random")
+    if python_state is None or not isinstance(numpy_payload, dict):
+        raise ValueError("Incomplete RNG state payload")
+    random.setstate(_python_random_state_from_json(python_state))
+    numpy.random.set_state(
+        (
+            str(numpy_payload["bit_generator"]),
+            numpy.asarray(numpy_payload["keys"], dtype=numpy.uint32),
+            int(numpy_payload["position"]),
+            int(numpy_payload["has_gauss"]),
+            float(numpy_payload["cached_gaussian"]),
+        )
+    )
+
+
